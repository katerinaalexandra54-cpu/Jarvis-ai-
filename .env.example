# ---- JARVIS server (server/index.js) ----
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=            # the AI key lives ONLY here, never in the app or git
JARVIS_TOKEN_SECRET=           # 16+ random characters; signs device tokens (openssl rand -hex 32)
JARVIS_INVITE_CODES=           # access code(s) typed into the app once, comma-separated
JARVIS_REVOKED=                # optional: comma-separated device ids to block
ALLOWED_MODELS=                # optional model allowlist, e.g. openai/gpt-4o,openai/gpt-4o-mini
DAILY_LIMIT=500                # AI requests per device per day
PORT=8787
ALLOWED_ORIGINS=               # extra browser origins; the APK works with the defaults
# JARVIS_ALLOW_ANONYMOUS=true  # LOCAL DEV ONLY: skips device auth

# ---- Old, unused by the app ----
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
CLAUDE_MODEL=claude-sonnet-4-6

# ---- App build (Vite) ----
VITE_API=                      # public https URL of the server -> secure build, no AI key on the phone
# VITE_ALLOW_DIRECT=true       # dev-only builds: allow pasting an OpenRouter key into the app
